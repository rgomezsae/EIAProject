# ============================================
# SECURITY: Environment & Secrets
# These files often contain passwords, API keys,
# and other sensitive data. NEVER commit them.
# ============================================
.env
.env.*
.env.local
.env.development
.env.production
*.pem
*.key
*.cert
credentials.json
secrets.json
service-account*.json

